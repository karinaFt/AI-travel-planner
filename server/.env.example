# Copy this file to server/.env to override values locally. Every value below is the default.

# Port the API listens on (a whole number from 1 to 65535).
PORT=3001

# Comma-separated browser origins allowed by CORS, as scheme://host[:port] with no path or trailing slash.
ALLOWED_ORIGINS=http://localhost:5173

# Gemini API key from Google AI Studio (create it in a project without billing to stay on the free tier). Leave empty to disable generation.
GEMINI_API_KEY=

# Gemini model used for itineraries; any model on your tier works (larger Flash models have less free quota).
GEMINI_MODEL=gemini-3.5-flash-lite

# Reverse proxies in front of the API (0-10). Keep 0 unless a proxy sets X-Forwarded-For; rate limits use the client IP.
TRUST_PROXY=0
